<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>АрбитражНВКЗ — Сканер</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💰</text></svg>">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>

<div id="overlay" class="overlay"></div>

<aside id="sidebar" class="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <span class="logo-icon-small">💰</span>
            <span><b>Арбитраж</b><span class="logo-accent">НВКЗ</span></span>
        </div>
        <button id="sidebar-close" class="icon-btn">✕</button>
    </div>

    <div class="sidebar-search">
        <input type="text" id="search-input" placeholder="🔍 Поиск пары (BTC, ETH...)" autocomplete="off">
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-title">Навигация</div>
        <a href="#" class="nav-item" data-target="top-section">
            <span class="nav-icon">🔥</span><span>Топ-10</span>
        </a>
        <a href="#" class="nav-item" data-target="favorites-section">
            <span class="nav-icon">⭐</span><span>Избранное</span>
            <span class="nav-count" id="fav-count">0</span>
        </a>
        <a href="#" class="nav-item" data-target="rest-section">
            <span class="nav-icon">📊</span><span>Остальные</span>
        </a>

        <div class="nav-section-title" style="margin-top: 20px;">Фильтры</div>
        <a href="#" class="nav-item filter-item active" data-filter="all">
            <span class="nav-icon">🌐</span><span>Все пары</span>
        </a>
        <a href="#" class="nav-item filter-item" data-filter="profit">
            <span class="nav-icon">💚</span><span>Только прибыльные</span>
        </a>
        <a href="#" class="nav-item filter-item" data-filter="favorites">
            <span class="nav-icon">⭐</span><span>Только избранные</span>
        </a>

        <div class="nav-section-title" style="margin-top: 20px;">Настройки</div>
        <a href="#" class="nav-item" id="nav-theme">
            <span class="nav-icon" id="theme-icon-side">🌙</span>
            <span id="theme-label-side">Тёмная тема</span>
        </a>
        <a href="#" class="nav-item" id="nav-refresh">
            <span class="nav-icon">🔄</span><span>Обновить сейчас</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-stats">
            <div class="stat-item">
                <div class="stat-value" id="stat-total">0</div>
                <div class="stat-label">Всего</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="stat-profit">0</div>
                <div class="stat-label">Прибыль</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="stat-fav">0</div>
                <div class="stat-label">Избран.</div>
            </div>
        </div>
        <div class="sidebar-info">9 бирж • 24/7</div>
    </div>
</aside>

<header>
    <div class="logo-block">
        <button id="menu-toggle" class="icon-btn menu-btn">☰</button>
        <div class="logo-icon">💰</div>
        <div>
            <h1>Арбитраж<span class="logo-accent">НВКЗ</span></h1>
            <p class="tagline">Мониторинг спреда</p>
        </div>
    </div>
    <div class="header-controls">
        <div class="header-meta">
            <span class="live-dot"></span>
            <span>LIVE</span>
            <span class="sep">•</span>
            <span id="header-pairs-count">{{ pairs_count|default(0) }} пар</span>
        </div>
        <div class="header-meta update-info">
            <span>🔄</span>
            <span id="update-counter">Обновлено только что</span>
        </div>
        <button id="theme-toggle" class="theme-btn">
            <span id="theme-icon">🌙</span>
        </button>
    </div>
</header>

<main class="page">

    <!-- ВКЛАДКИ -->
    <div class="tabs">
        <button class="tab-btn active" data-tab="futures">
            🚀 Фьючерсы <span class="tab-badge">{{ pairs_count }}</span>
        </button>
        <button class="tab-btn" data-tab="spot">
            💵 Спот <span class="tab-badge">{{ pairs_count }}</span>
        </button>
    </div>

    <!-- ================= ФЬЮЧЕРСЫ ================= -->
    <div id="tab-futures" class="tab-content active">

        <section id="favorites-section" class="favorites-section" style="display:none;">
            <h2 class="favorites-title">⭐ Избранное</h2>
            <p class="favorites-subtitle">Твои отслеживаемые пары всегда наверху</p>
            <div class="grid-2" id="favorites-grid"></div>
        </section>

        {% if top_spreads %}
        <section class="top-section" id="top-section">
            <h2 class="top-title">🔥 Топ-10 возможностей</h2>
            <p class="top-subtitle">Наибольший процентный спред</p>
            <div class="grid-2" id="top-grid">
                {% for pair, data in top_spreads.items() %}
                <div class="pair-card top-card" data-pair="{{ pair }}" data-profit="{{ data.net_profit_usdt }}">
                    <div class="card-header">
                        <h2>{{ pair }}</h2>
                        <button class="fav-btn" data-pair="{{ pair }}">☆</button>
                    </div>
                    <div class="spread-info">
                        <span class="spread-usd">Спред: {{ data.spread_usd|fmt }} USDT</span>
                        <span class="spread-pct">({{ "%.4f"|format(data.spread_pct) }}%)</span>
                        {% if data.net_profit_usdt > 0 %}
                            <span class="net-profit profit-positive">✅ +{{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% else %}
                            <span class="net-profit profit-negative">❌ {{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% endif %}
                    </div>
                    <table>
                        <thead><tr><th>Биржа</th><th>Ask</th><th>Bid</th></tr></thead>
                        <tbody>
                            {% for quote in quotes.get(pair, []) %}
                            <tr class="{% if quote.exchange == data.min_ask_exchange %}row-buy{% elif quote.exchange == data.max_bid_exchange %}row-sell{% endif %}">
                                <td>
                                    {{ quote.exchange }}
                                    {% if quote.exchange == data.min_ask_exchange and quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-both">обе</span>
                                    {% elif quote.exchange == data.min_ask_exchange %}
                                        <span class="tag tag-buy">← КУПИТЬ</span>
                                    {% elif quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-sell">← ПРОДАТЬ</span>
                                    {% endif %}
                                </td>
                                <td class="ask">{{ quote.ask|fmt }}</td>
                                <td class="bid">{{ quote.bid|fmt }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="action-hint">
                        🟢 <b>{{ data.min_ask_exchange.upper() }}</b> {{ data.min_ask|fmt }}
                        <span class="arrow">→</span>
                        🔴 <b>{{ data.max_bid_exchange.upper() }}</b> {{ data.max_bid|fmt }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        {% if spreads %}
        <section class="rest-section" id="rest-section">
            <h2 class="rest-title">📊 Остальные пары</h2>
            <div class="grid-2" id="rest-grid">
                {% for pair, data in spreads.items() %}
                <div class="pair-card" data-pair="{{ pair }}" data-profit="{{ data.net_profit_usdt }}">
                    <div class="card-header">
                        <h2>{{ pair }}</h2>
                        <button class="fav-btn" data-pair="{{ pair }}">☆</button>
                    </div>
                    <div class="spread-info">
                        <span class="spread-usd">Спред: {{ data.spread_usd|fmt }} USDT</span>
                        <span class="spread-pct">({{ "%.4f"|format(data.spread_pct) }}%)</span>
                        {% if data.net_profit_usdt > 0 %}
                            <span class="net-profit profit-positive">✅ +{{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% else %}
                            <span class="net-profit profit-negative">❌ {{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% endif %}
                    </div>
                    <table>
                        <thead><tr><th>Биржа</th><th>Ask</th><th>Bid</th></tr></thead>
                        <tbody>
                            {% for quote in quotes.get(pair, []) %}
                            <tr class="{% if quote.exchange == data.min_ask_exchange %}row-buy{% elif quote.exchange == data.max_bid_exchange %}row-sell{% endif %}">
                                <td>
                                    {{ quote.exchange }}
                                    {% if quote.exchange == data.min_ask_exchange and quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-both">обе</span>
                                    {% elif quote.exchange == data.min_ask_exchange %}
                                        <span class="tag tag-buy">← КУПИТЬ</span>
                                    {% elif quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-sell">← ПРОДАТЬ</span>
                                    {% endif %}
                                </td>
                                <td class="ask">{{ quote.ask|fmt }}</td>
                                <td class="bid">{{ quote.bid|fmt }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="action-hint">
                        🟢 <b>{{ data.min_ask_exchange.upper() }}</b> {{ data.min_ask|fmt }}
                        <span class="arrow">→</span>
                        🔴 <b>{{ data.max_bid_exchange.upper() }}</b> {{ data.max_bid|fmt }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </div>

    <!-- ================= СПОТ ================= -->
    <div id="tab-spot" class="tab-content">

        {% if spot_top_spreads %}
        <section class="top-section">
            <h2 class="top-title">💵 Топ-10 спот-возможностей</h2>
            <p class="top-subtitle">Наибольший процентный спред (спот)</p>
            <div class="grid-2">
                {% for pair, data in spot_top_spreads.items() %}
                <div class="pair-card top-card spot-card" data-spot-pair="{{ pair }}">
                    <div class="card-header">
                        <h2>{{ pair }} <span class="spot-badge">SPOT</span></h2>
                        <button class="fav-btn" data-pair="{{ pair }}">☆</button>
                    </div>
                    <div class="spread-info">
                        <span class="spread-usd">Спред: {{ data.spread_usd|fmt }} USDT</span>
                        <span class="spread-pct">({{ "%.4f"|format(data.spread_pct) }}%)</span>
                        {% if data.net_profit_usdt > 0 %}
                            <span class="net-profit profit-positive">✅ +{{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% else %}
                            <span class="net-profit profit-negative">❌ {{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% endif %}
                    </div>
                    <table>
                        <thead><tr><th>Биржа</th><th>Ask</th><th>Bid</th></tr></thead>
                        <tbody>
                            {% for quote in spot_quotes.get(pair, []) %}
                            <tr class="{% if quote.exchange == data.min_ask_exchange %}row-buy{% elif quote.exchange == data.max_bid_exchange %}row-sell{% endif %}">
                                <td>
                                    {{ quote.exchange }}
                                    {% if quote.exchange == data.min_ask_exchange and quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-both">обе</span>
                                    {% elif quote.exchange == data.min_ask_exchange %}
                                        <span class="tag tag-buy">← КУПИТЬ</span>
                                    {% elif quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-sell">← ПРОДАТЬ</span>
                                    {% endif %}
                                </td>
                                <td class="ask">{{ quote.ask|fmt }}</td>
                                <td class="bid">{{ quote.bid|fmt }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="action-hint">
                        🟢 <b>{{ data.min_ask_exchange.upper() }}</b> {{ data.min_ask|fmt }}
                        <span class="arrow">→</span>
                        🔴 <b>{{ data.max_bid_exchange.upper() }}</b> {{ data.max_bid|fmt }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        {% if spot_spreads %}
        <section class="rest-section">
            <h2 class="rest-title">📊 Остальные спот-пары</h2>
            <div class="grid-2">
                {% for pair, data in spot_spreads.items() %}
                <div class="pair-card spot-card" data-spot-pair="{{ pair }}">
                    <div class="card-header">
                        <h2>{{ pair }} <span class="spot-badge">SPOT</span></h2>
                        <button class="fav-btn" data-pair="{{ pair }}">☆</button>
                    </div>
                    <div class="spread-info">
                        <span class="spread-usd">Спред: {{ data.spread_usd|fmt }} USDT</span>
                        <span class="spread-pct">({{ "%.4f"|format(data.spread_pct) }}%)</span>
                        {% if data.net_profit_usdt > 0 %}
                            <span class="net-profit profit-positive">✅ +{{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% else %}
                            <span class="net-profit profit-negative">❌ {{ "%.2f"|format(data.net_profit_usdt) }} USDT</span>
                        {% endif %}
                    </div>
                    <table>
                        <thead><tr><th>Биржа</th><th>Ask</th><th>Bid</th></tr></thead>
                        <tbody>
                            {% for quote in spot_quotes.get(pair, []) %}
                            <tr class="{% if quote.exchange == data.min_ask_exchange %}row-buy{% elif quote.exchange == data.max_bid_exchange %}row-sell{% endif %}">
                                <td>
                                    {{ quote.exchange }}
                                    {% if quote.exchange == data.min_ask_exchange and quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-both">обе</span>
                                    {% elif quote.exchange == data.min_ask_exchange %}
                                        <span class="tag tag-buy">← КУПИТЬ</span>
                                    {% elif quote.exchange == data.max_bid_exchange %}
                                        <span class="tag tag-sell">← ПРОДАТЬ</span>
                                    {% endif %}
                                </td>
                                <td class="ask">{{ quote.ask|fmt }}</td>
                                <td class="bid">{{ quote.bid|fmt }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="action-hint">
                        🟢 <b>{{ data.min_ask_exchange.upper() }}</b> {{ data.min_ask|fmt }}
                        <span class="arrow">→</span>
                        🔴 <b>{{ data.max_bid_exchange.upper() }}</b> {{ data.max_bid|fmt }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </div>

    <p id="no-results" class="loading" style="display:none;">🔍 Ничего не найдено</p>
</main>

<footer>
    <div class="footer-content">
        <span>💰 <b>АрбитражНВКЗ</b> © 2026</span>
        <span class="sep">•</span>
        <span>Автообновление 15 сек</span>
        <span class="sep">•</span>
        <span>9 бирж • фьючерсы + спот</span>
    </div>
</footer>

<script>
// ============ ВКЛАДКИ ============
(function() {
    const savedTab = localStorage.getItem('active_tab') || 'futures';
    document.documentElement.classList.add('filters-pending');
    window.__initialTab = savedTab;
})();

function initTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    function activateTab(name) {
        tabBtns.forEach(b => b.classList.toggle('active', b.dataset.tab === name));
        tabContents.forEach(c => c.classList.toggle('active', c.id === 'tab-' + name));
        localStorage.setItem('active_tab', name);
    }

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => activateTab(btn.dataset.tab));
    });

    activateTab(window.__initialTab || 'futures');
}

// ============ ТЕМА ============
(function() {
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
})();

function updateThemeUI(theme) {
    const icon = document.getElementById('theme-icon');
    const iconSide = document.getElementById('theme-icon-side');
    const labelSide = document.getElementById('theme-label-side');
    if (icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
    if (iconSide) iconSide.textContent = theme === 'dark' ? '☀️' : '🌙';
    if (labelSide) labelSide.textContent = theme === 'dark' ? 'Светлая тема' : 'Тёмная тема';
}

function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateThemeUI(next);
}

// ============ МЕНЮ ============
const sidebar = document.getElementById('sidebar');
const overlay = document.getElementById('overlay');

function openSidebar() {
    sidebar.classList.add('open');
    overlay.classList.add('show');
    document.body.style.overflow = 'hidden';
    localStorage.setItem('sidebar_open', '1');
}

function closeSidebar() {
    sidebar.classList.remove('open');
    overlay.classList.remove('show');
    document.body.style.overflow = '';
    localStorage.setItem('sidebar_open', '0');
}

document.getElementById('menu-toggle').addEventListener('click', openSidebar);
document.getElementById('sidebar-close').addEventListener('click', closeSidebar);
overlay.addEventListener('click', closeSidebar);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSidebar(); });

// ============ СЧЁТЧИК ============
const pageLoadTime = Date.now();
function updateCounter() {
    const el = document.getElementById('update-counter');
    if (!el) return;
    const s = Math.floor((Date.now() - pageLoadTime) / 1000);
    if (s < 5) el.textContent = 'Обновлено только что';
    else if (s < 60) el.textContent = `Обновлено ${s} сек назад`;
    else el.textContent = `Обновлено ${Math.floor(s / 60)} мин назад`;
}
setInterval(updateCounter, 1000);
updateCounter();

document.getElementById('nav-refresh').addEventListener('click', e => {
    e.preventDefault();
    window.location.reload();
});
document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
document.getElementById('nav-theme').addEventListener('click', e => {
    e.preventDefault();
    toggleTheme();
});

// ============ ИЗБРАННОЕ ============
const FAV_KEY = 'favorite_pairs';
function getFavorites() {
    try { return JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); }
    catch(e) { return []; }
}
function saveFavorites(list) { localStorage.setItem(FAV_KEY, JSON.stringify(list)); }

function updateStats() {
    const seen = new Set();
    document.querySelectorAll('#top-grid .pair-card[data-pair], #rest-grid .pair-card[data-pair]').forEach(c => {
        seen.add(c.dataset.pair);
    });
    const total = seen.size;
    let profitCount = 0;
    document.querySelectorAll('#top-grid .pair-card[data-pair], #rest-grid .pair-card[data-pair]').forEach(c => {
        if (parseFloat(c.dataset.profit) > 0) profitCount++;
    });
    const favCount = getFavorites().length;
    document.getElementById('stat-total').textContent = total;
    document.getElementById('stat-profit').textContent = profitCount;
    document.getElementById('stat-fav').textContent = favCount;
    document.getElementById('fav-count').textContent = favCount;
    const headerCount = document.getElementById('header-pairs-count');
    if (headerCount) headerCount.textContent = total + ' пар';
}

function renderFavorites() {
    const favorites = getFavorites();
    const favSection = document.getElementById('favorites-section');
    const favGrid = document.getElementById('favorites-grid');
    favGrid.innerHTML = '';

    document.querySelectorAll('.fav-btn').forEach(btn => {
        const isFav = favorites.includes(btn.dataset.pair);
        btn.textContent = isFav ? '★' : '☆';
        btn.classList.toggle('active', isFav);
    });

    if (favorites.length === 0) {
        favSection.style.display = 'none';
        updateStats();
        return;
    }

    favSection.style.display = 'block';
    document.querySelectorAll('#top-grid .pair-card[data-pair], #rest-grid .pair-card[data-pair]').forEach(card => {
        if (favorites.includes(card.dataset.pair)) {
            favGrid.appendChild(card.cloneNode(true));
        }
    });
    bindFavButtons();
    updateStats();
}

function bindFavButtons() {
        // Обработчики уже навешаны через делегирование — ничего не делаем
    });
}

// ============ ФИЛЬТРЫ ============
function applyFilters() {
    const filter = localStorage.getItem('filter') || 'all';
    const search = (localStorage.getItem('search') || '').toLowerCase().trim();
    const favorites = getFavorites();
    const activeTab = localStorage.getItem('active_tab') || 'futures';
    const tabEl = document.getElementById('tab-' + activeTab);

    if (!tabEl) return;

    let visible = 0;
    tabEl.querySelectorAll('.pair-card[data-pair]').forEach(card => {
        const pair = card.dataset.pair;
        const profit = parseFloat(card.dataset.profit);
        let show = true;
        if (filter === 'profit' && profit <= 0) show = false;
        if (filter === 'favorites' && !favorites.includes(pair)) show = false;
        if (search && !pair.toLowerCase().includes(search)) show = false;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    document.getElementById('no-results').style.display = visible === 0 ? 'block' : 'none';
}

document.querySelectorAll('.filter-item').forEach(item => {
    item.addEventListener('click', function(e) {
        e.preventDefault();
        document.querySelectorAll('.filter-item').forEach(i => i.classList.remove('active'));
        e.currentTarget.classList.add('active');
        localStorage.setItem('filter', e.currentTarget.dataset.filter);
        applyFilters();
        closeSidebar();
    });
});

document.getElementById('search-input').addEventListener('input', function() {
    localStorage.setItem('search', this.value);
    applyFilters();
});

// ============ НАВИГАЦИЯ ============
document.querySelectorAll('.nav-item[data-target]').forEach(item => {
    item.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.getElementById(e.currentTarget.dataset.target);
        if (target && target.style.display !== 'none') {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            target.classList.add('highlight-flash');
            setTimeout(() => target.classList.remove('highlight-flash'), 1000);
        }
        closeSidebar();
    });
});

// ============ СТАРТ ============
document.addEventListener('DOMContentLoaded', function() {
    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');
    initTabs();

    // Восстанавливаем активные фильтры
    const savedFilter = localStorage.getItem('filter') || 'all';
    document.querySelectorAll('.filter-item').forEach(i => {
        i.classList.toggle('active', i.dataset.filter === savedFilter);
    });
    document.getElementById('search-input').value = localStorage.getItem('search') || '';

    renderFavorites();
    updateStats();
    applyFilters();

    // Восстанавливаем sidebar
    if (localStorage.getItem('sidebar_open') === '1') {
        sidebar.classList.add('open');
        overlay.classList.add('show');
    }

    document.documentElement.classList.remove('filters-pending');
});

setTimeout(() => window.location.reload(), 15000);
</script>
</body>
</html>
